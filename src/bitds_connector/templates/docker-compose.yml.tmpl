# Plantilla del stack del participante. La rellena generate.py con str.format(): los
# marcadores entre llaves se sustituyen, y por eso el fichero no puede contener
# ninguna otra llave literal. Los marcadores van entrecomillados para que la
# plantilla siga siendo YAML valido tal cual.
name: "{name}"

secrets:
  provider_config_secret:
    file: ./provider_config_secret.properties
  identityhub_config_secret:
    file: ./identityhub_config_secret.properties

volumes:
  db-data:
  vault-data:

services:
  db:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_DB: "{db_name}"
      POSTGRES_USER: "{db_user}"
      POSTGRES_PASSWORD: "{db_password}"
    volumes:
      - db-data:/var/lib/postgresql/data
      # Crea la BD del IdentityHub; solo se ejecuta con el volumen vacio.
      - ./db-init.sql:/docker-entrypoint-initdb.d/identityhub.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {db_user} -d {db_name}"]
      interval: 5s
      retries: 10

  vault:
    image: "{vault_image}"
    restart: unless-stopped
    cap_add: [IPC_LOCK]
    command: server
    volumes:
      - vault-data:/vault/file
      - ./vault/config:/vault/config:ro
    healthcheck:
      test: ["CMD", "wget", "-q", "-O-", "http://127.0.0.1:8200/v1/sys/health?sealedcode=200&uninitcode=200"]
      interval: 3s
      timeout: 3s
      retries: 20

  vault-init:
    image: "{vault_image}"
    restart: "no"
    depends_on:
      vault:
        condition: service_healthy
    # El usuario del host, para que vault/keys/init.txt sea suyo y no de root.
    user: "{uid}:{gid}"
    environment:
      VAULT_ADDR: http://vault:8200
    entrypoint: ["/bin/sh", "/vault-init.sh"]
    secrets:
      - identityhub_config_secret
    volumes:
      - ./vault/vault-init.sh:/vault-init.sh:ro
      - ./vault/keys:/vault/keys

  identityhub:
    image: "{ih_image}"
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
      vault-init:
        condition: service_completed_successfully
    ports:
      # Publicos: otros conectores resuelven aqui el DID y piden presentaciones.
      - "{ih_credentials}:{ih_credentials}"
      - "{ih_did}:{ih_did}"
      # Identity API (administracion): solo desde este servidor.
      - "127.0.0.1:{ih_identity}:{ih_identity}"
    secrets:
      - identityhub_config_secret
    entrypoint: ["java", "-Dedc.fs.config=/run/secrets/identityhub_config_secret", "-jar", "/identity-hub.jar"]

  key-init:
    image: alpine/openssl:latest
    restart: "no"
    volumes:
      - ./keys:/identity
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        if [ ! -f /identity/ed25519_private.pem ]; then
          openssl genpkey -algorithm Ed25519 -out /identity/ed25519_private.pem
          openssl pkey -in /identity/ed25519_private.pem -pubout -out /identity/ed25519_public.pem
          chmod 600 /identity/ed25519_private.pem
          chmod 644 /identity/ed25519_public.pem
          echo "Claves generadas."
        else
          echo "Las claves ya existen."
        fi

  provider:
    image: "{image}"
    container_name: "provider-{name}"
    restart: unless-stopped
    depends_on:
      key-init:
        condition: service_completed_successfully
      db:
        condition: service_healthy
      identityhub:
        condition: service_started
    ports:
      - "{http}:{http}"
      - "{management}:{management}"
      - "{protocol}:{protocol}"
      - "{public}:{public}"
    secrets:
      - provider_config_secret
    # Solo las claves EDR: el resto del directorio (claves del vault) no le hace falta.
    volumes:
      - ./keys:/identity:ro
    entrypoint: ["/bin/sh", "-c", "[ -f /connector-base.jar ] && exec java -Dedc.fs.config=/run/secrets/provider_config_secret -jar /connector-base.jar --log-level=DEBUG; exec java -Dedc.fs.config=/run/secrets/provider_config_secret -jar /provider-base.jar --log-level=DEBUG"]
